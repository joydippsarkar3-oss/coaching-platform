# Environment — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.staging

# Android signing — NEVER commit
android/key.properties
android/computrain.jks
android/*.jks
android/*.keystore

# Firebase — project identifiers (no private keys) are safe to commit.
# Private key stays in backend/.env only (FIREBASE_PRIVATE_KEY).
# app/lib/firebase_options.dart is intentionally tracked.

# Flutter
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/pubspec.lock
app/build/
app/.idea/
app/android/.gradle/
app/android/local.properties
app/android/captures/
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/flutter_export_environment.sh

