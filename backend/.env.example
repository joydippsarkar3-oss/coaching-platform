# ──────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ──────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/franchise_training?schema=public"

# ──────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────
# JWT (use long random strings in production)
# ──────────────────────────────────────────────────
JWT_SECRET="change_me_to_a_long_random_secret_at_least_32_chars"
JWT_REFRESH_SECRET="change_me_to_another_long_random_secret_at_least_32_chars"

# ──────────────────────────────────────────────────
# SMS — MSG91 (DLT-registered, India TRAI mandate)
# Steps: dlt.airtelbusiness.com (or Jio/BSNL/Tata) →
#   register entity → register sender → register templates → get TE IDs
# Then: MSG91 dashboard → API → Auth Key
# ──────────────────────────────────────────────────
MSG91_AUTH_KEY=                     # MSG91 dashboard → API → Auth Key
MSG91_SENDER_ID=FRNCHZ              # 6-char alphanumeric, approved on DLT portal
MSG91_DLT_TE_ID=                    # DLT Template Entity ID for default OTP template
# Per-template TE IDs (add more as you register templates):
MSG91_DLT_TE_ID_FEE_REMINDER=
MSG91_DLT_TE_ID_CERT_ISSUED=
MSG91_DLT_TE_ID_EXAM_RESULT=

# ──────────────────────────────────────────────────
# WhatsApp Business API (Meta Cloud API v19+)
# Steps: business.facebook.com → Business Settings →
#   System Users → create → assign WABA asset → generate token
#   Add phone number → verify → copy Phone Number ID
# ──────────────────────────────────────────────────
WABA_ACCESS_TOKEN=                  # System-user permanent token (not a page token)
WABA_PHONE_NUMBER_ID=               # Meta Business Manager → WhatsApp → Phone numbers
WABA_BUSINESS_ACCOUNT_ID=           # Optional — needed for template management API
META_WEBHOOK_VERIFY_TOKEN=          # Any random string; set same in Meta webhook config
# Template names (submit via Meta BM → WhatsApp → Message Templates):
WABA_TEMPLATE_FEE_REMINDER=fee_reminder_v1
WABA_TEMPLATE_CERT_ISSUED=certificate_issued_v1
WABA_TEMPLATE_EXAM_RESULT=exam_result_v1
WABA_TEMPLATE_OTP=otp_login_v1

# ──────────────────────────────────────────────────
# AWS / S3
# ──────────────────────────────────────────────────
S3_BUCKET="your-s3-bucket-name"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# ──────────────────────────────────────────────────
# Payment Gateway (e.g. Razorpay, PayU)
# ──────────────────────────────────────────────────
PAYMENT_GATEWAY_KEY="your_payment_gateway_key"
PAYMENT_GATEWAY_SECRET="your_payment_gateway_secret"

# ──────────────────────────────────────────────────
# Monitoring
# ──────────────────────────────────────────────────
SENTRY_DSN="https://your_sentry_dsn@sentry.io/project_id"

# ──────────────────────────────────────────────────
# Payment Gateway (extended)
# ──────────────────────────────────────────────────
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PUBLIC_BASE_URL=https://yourbrand.in
HO_SPLIT_BPS=1500
