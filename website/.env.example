# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# Internal API secret (server-side only — never expose to client)
API_SECRET_KEY=your-secret-key-here

# CDN hostname for images (used in next.config.ts)
CDN_HOSTNAME=cdn.example.com

# WhatsApp Head Office fallback number (with country code, no +)
NEXT_PUBLIC_HO_WHATSAPP=919876543210

# Google Maps Embed API Key (for center map embeds)
NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-key

# Site URL (used for canonical + OG tags)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Revalidation secret for ISR webhooks
REVALIDATION_SECRET=your-revalidation-secret

# Rate-limit for verify endpoint (requests per minute per IP)
VERIFY_RATE_LIMIT_RPM=10
